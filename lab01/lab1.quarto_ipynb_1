    "#| echo: false\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "def fa(x, y0):\n",
    "    return - 1 / (x - 1 / y0)\n",
    "\n",
    "x = np.linspace(0, 1, 100)\n",
    "\n",
    "fig, ax = plt.subplots(dpi=150)\n",
    "\n",
    "y0_arr = [-2, -1, 1, 2]\n",
    "\n",
    "for y0 in y0_arr:\n",
    "    ax.plot(x, fa(x, y0), label=f\"$y_0 = $ {y0}\", lw=1.0)\n",
    "\n",
    "ax.set_xlim(0, 1)\n",
    "ax.set_ylim(-10, 10)\n",
    "ax.set_xlabel(\"$x$\")\n",
    "ax.set_ylabel(\"$y$\")\n",
    "\n",
    "plt.legend()\n",
    "\n",
    "\n",
    "plt.show()"
   ]
  },
