    "#| output: true\n",
    "\n",
    "from scipy.integrate import solve_ivp\n",
    "\n",
    "fig, ax = plt.subplots(dpi=150)\n",
    "\n",
    "def f(x, y):\n",
    "    return y **2\n",
    "\n",
    "y0_arr = [-2, -1, 1, 2]\n",
    "rtol = 1e-6\n",
    "atol = 1e-3\n",
    "max_step = 0.001\n",
    "x_range = [0, 1]\n",
    "\n",
    "sol_dict = {}\n",
    "\n",
    "for y0 in y0_arr:\n",
    "    sol = solve_ivp(f, x_range, [y0], method=\"RK45\", rtol=rtol, atol=atol, max_step=max_step)\n",
    "\n",
    "    ax.plot(sol.t, sol.y[0], label=f\"$y_0 = $ {y0}\", lw=1.0)\n",
    "    ax.set_xlim(0, 1)\n",
    "    ax.set_ylim(-3, 10)\n",
    "    ax.set_xlabel(\"$x$\")\n",
    "    ax.set_ylabel(\"$y$\")\n",
    "    sol_dict[y0] = sol\n",
    "\n",
    "plt.legend()"
   ]
